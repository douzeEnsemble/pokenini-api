<?xml version="1.0"?>
<psalm
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
    errorLevel="1"
    resolveFromConfigFile="true"
    findUnusedCode="true"
    cacheDirectory="var/cache/psalm"
>
    <projectFiles>
        <directory name="src"/>
        <directory name="tests"/>
        <ignoreFiles>
            <directory name="vendor"/>
            <file name="src/Kernel.php" />
            <file name="tests/bootstrap.php"/>
            <file name="tests/object-manager.php"/>
        </ignoreFiles>
    </projectFiles>

    <plugins>
        <pluginClass class="Psalm\SymfonyPsalmPlugin\Plugin">
            <containerXml>var/cache/test/App_KernelTestDebugContainer.xml</containerXml>
        </pluginClass>
        <pluginClass class="Psalm\PhpUnitPlugin\Plugin">
            <containerXml>var/cache/test/App_KernelTestDebugContainer.xml</containerXml>
        </pluginClass>
    </plugins>

    <issueHandlers>
        <InvalidArgument>
            <errorLevel type="suppress">
                <referencedFunction name="PHPUnit\Framework\Attributes\CoversTrait::__construct"/>
            </errorLevel>
        </InvalidArgument>

        <ClassMustBeFinal>
            <errorLevel type="suppress">
                <!-- Symfony services -->
                <directory name="src/Calculator" />
                <directory name="src/Repository" />
                <directory name="src/Service" />
                <directory name="src/Updater" />
            </errorLevel>
        </ClassMustBeFinal>

        <MissingConstructor>
            <errorLevel type="suppress">
                <directory name="src/Entity" />
            </errorLevel>
        </MissingConstructor>

        <PossiblyUnusedProperty>
            <errorLevel type="suppress">
                <directory name="src/Entity" />
            </errorLevel>
        </PossiblyUnusedProperty>

        <PossiblyUnusedMethod>
            <errorLevel type="suppress">
                <directory name="src/Controller" />
            </errorLevel>
        </PossiblyUnusedMethod>

        <UnnecessaryVarAnnotation>
            <errorLevel type="suppress">
                <file name="src/Service/SpreadsheetService.php" />
            </errorLevel>
        </UnnecessaryVarAnnotation>
    </issueHandlers>
</psalm>
